{
  "version": 2,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/api/wallpaper",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=21600, s-maxage=21600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
